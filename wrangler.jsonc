{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payhealth",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "observability": { "enabled": true },
  // Dashboard pages. Paths that are not files (/api/*, /webhook) go to the Worker.
  "assets": { "directory": "./public" },
  "vars": {
    // Sandbox only. Do not change to the live API.
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    // Simulator events fail PayPal signature checks. When "true", they are
    // stored with verified=0 instead of being rejected. Sandbox demo only.
    "ALLOW_UNVERIFIED_SIMULATOR": "true",
    // Max model calls per UTC day. Over the cap, disputes get the last saved draft.
    "AI_DAILY_CAP": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payhealth",
      // Remote D1 database (created 2026-11-02).
      "database_id": "c592fcb5-e91b-4d59-871e-42246c4bb6dd",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  // PP_ID, PP_SECRET, PAYPAL_WEBHOOK_ID, ANTHROPIC_API_KEY, DEMO_PASSWORD
}
